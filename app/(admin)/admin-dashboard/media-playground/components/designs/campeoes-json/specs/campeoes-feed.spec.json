{
  "root": "canvas",
  "elements": {
    "canvas": {
      "type": "MediaCanvas",
      "props": {
        "background": "linear-gradient(180deg, #24549C 0%, #0C1D36 100%)",
        "fontFamily": "var(--font-raleway), ui-sans-serif, system-ui, sans-serif",
        "overflow": "hidden"
      },
      "children": ["atmosphere-radials", "atmosphere-noise", "atmosphere-stripes", "atmosphere-vignette", "main", "footer"]
    },
    "atmosphere-radials": {
      "type": "MediaBox",
      "props": {
        "position": "absolute",
        "top": 0,
        "left": 0,
        "width": "100%",
        "height": "100%",
        "pointerEvents": "none",
        "zIndex": 0,
        "background": "radial-gradient(ellipse 80% 50% at 100% 0%, rgba(255, 200, 80, 0.08) 0%, transparent 52%), radial-gradient(ellipse 55% 40% at 0% 100%, rgba(15, 40, 80, 0.45) 0%, transparent 50%)"
      }
    },
    "atmosphere-noise": {
      "type": "MediaBox",
      "props": {
        "position": "absolute",
        "top": 0,
        "left": 0,
        "width": "100%",
        "height": "100%",
        "pointerEvents": "none",
        "opacity": 0.4,
        "backgroundImage": "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\")",
        "backgroundSize": "180px 180px",
        "mixBlendMode": "overlay"
      }
    },
    "atmosphere-stripes": {
      "type": "MediaBox",
      "props": {
        "position": "absolute",
        "top": 0,
        "left": 0,
        "width": "100%",
        "height": "100%",
        "pointerEvents": "none",
        "background": "repeating-linear-gradient(-28deg, transparent, transparent 56px, rgba(255,255,255,0.014) 56px, rgba(255,255,255,0.014) 57px)"
      }
    },
    "atmosphere-vignette": {
      "type": "MediaBox",
      "props": {
        "position": "absolute",
        "top": 0,
        "left": 0,
        "width": "100%",
        "height": "100%",
        "pointerEvents": "none",
        "background": "radial-gradient(ellipse at 50% 100%, rgba(0,0,0,0.25) 0%, transparent 55%)"
      }
    },
    "main": {
      "type": "MediaStack",
      "props": {
        "position": "relative",
        "zIndex": 1,
        "paddingTop": 44,
        "paddingBottom": 130,
        "paddingX": 48,
        "gap": 22
      },
      "children": ["hero", "cta", "club", "metrics", "distribution-row", "delivery"]
    },
    "hero": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,1fr)", 332],
        "gap": 20,
        "alignItems": "start",
        "paddingBottom": 18
      },
      "children": ["hero-copy", "hero-card"]
    },
    "hero-copy": {
      "type": "MediaStack",
      "props": {
        "gap": 18
      },
      "children": ["hero-title", "hero-body"]
    },
    "hero-title": {
      "type": "MediaText",
      "props": {
        "size": 60,
        "weight": "bold",
        "color": "#FAFAFA",
        "lineHeight": 1.06,
        "tracking": "-0.032em",
        "shadow": "0 4px 28px rgba(0,0,0,0.35)",
        "lines": [
          [{ "text": "Crie campanhas automáticas" }],
          [
            { "text": "de " },
            { "text": "WhatsApp", "color": "#FFCD2E", "weight": "bold" },
            { "text": " e aumente" }
          ],
          [
            { "text": "sua " },
            { "text": "taxa de recompra", "color": "#FFCD2E", "weight": "bold", "underlineColor": "rgba(255, 205, 46, 0.55)", "underlineThickness": 3, "skipInkNone": true }
          ]
        ]
      }
    },
    "hero-body": {
      "type": "MediaText",
      "props": {
        "size": 20,
        "weight": "medium",
        "color": "rgba(252,252,252,0.78)",
        "lineHeight": 1.55,
        "lines": [
          [
            { "text": "A Ampère+ criou um clube exclusivo para seus campeões de compra com o " },
            { "text": "RecompraCRM", "color": "#FFCD2E", "weight": "bold" },
            { "text": " e os resultados falam por si." }
          ]
        ]
      }
    },
    "hero-card": {
      "type": "MediaSurface",
      "props": {
        "background": "linear-gradient(165deg, #FFFFFF 0%, #F4F7FB 100%)",
        "borderRadius": 20,
        "boxShadow": "0 18px 44px rgba(0,0,0,0.32), 0 0 0 1px rgba(255,255,255,0.7), 0 0 80px rgba(0,0,0,0.12)",
        "rotateDeg": -0.9,
        "overflow": "hidden"
      },
      "children": ["hero-card-top", "hero-card-bottom"]
    },
    "hero-card-top": {
      "type": "MediaStack",
      "props": {
        "paddingY": 20,
        "paddingX": 22,
        "gap": 10
      },
      "children": ["hero-card-eyebrow", "hero-card-value"]
    },
    "hero-card-eyebrow": {
      "type": "MediaText",
      "props": {
        "text": "Receita atribuída",
        "size": 9,
        "weight": "bold",
        "color": "#9CA3AF",
        "uppercase": true,
        "tracking": "0.1em"
      }
    },
    "hero-card-value": {
      "type": "MediaText",
      "props": {
        "text": "R$ 29.408,63",
        "size": 30,
        "weight": "bold",
        "color": "#1E3A5F",
        "tracking": "-0.03em",
        "lineHeight": 1.1,
        "whiteSpace": "nowrap"
      }
    },
    "hero-card-bottom": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,1fr)", "minmax(0,1fr)"],
        "background": "linear-gradient(180deg, #E8F1FF 0%, #DDE9FC 100%)",
        "borderTop": "1px solid rgba(226,232,240,0.95)"
      },
      "children": ["hero-card-rate", "hero-card-conversions"]
    },
    "hero-card-rate": {
      "type": "MediaStack",
      "props": {
        "paddingY": 12,
        "paddingX": 14,
        "gap": 5,
        "borderRight": "1px solid rgba(203,213,225,0.55)"
      },
      "children": ["hero-card-rate-label", "hero-card-rate-value"]
    },
    "hero-card-rate-label": {
      "type": "MediaText",
      "props": {
        "text": "Taxa de conversão",
        "size": 8,
        "weight": "bold",
        "color": "#64748B",
        "uppercase": true,
        "tracking": "0.08em"
      }
    },
    "hero-card-rate-value": {
      "type": "MediaText",
      "props": {
        "text": "75,39%",
        "size": 23,
        "weight": "bold",
        "color": "#059669",
        "tracking": "-0.02em"
      }
    },
    "hero-card-conversions": {
      "type": "MediaStack",
      "props": {
        "paddingY": 12,
        "paddingX": 14,
        "gap": 5
      },
      "children": ["hero-card-conversions-label", "hero-card-conversions-value"]
    },
    "hero-card-conversions-label": {
      "type": "MediaText",
      "props": {
        "text": "Conversões",
        "size": 8,
        "weight": "bold",
        "color": "#64748B",
        "uppercase": true,
        "tracking": "0.08em"
      }
    },
    "hero-card-conversions-value": {
      "type": "MediaText",
      "props": {
        "text": "144",
        "size": 23,
        "weight": "bold",
        "color": "#1E3A5F",
        "tracking": "-0.02em"
      }
    },
    "cta": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,1fr)", "auto"],
        "gap": 16,
        "alignItems": "center",
        "background": "linear-gradient(180deg, rgba(8,17,31,0.22) 0%, rgba(8,17,31,0.34) 100%)",
        "border": "1px solid rgba(255,255,255,0.08)",
        "borderRadius": 18,
        "paddingY": 16,
        "paddingX": 18,
        "backdropBlur": 10
      },
      "children": ["cta-copy", "cta-button"]
    },
    "cta-copy": {
      "type": "MediaText",
      "props": {
        "size": 20,
        "weight": "medium",
        "color": "rgba(248,250,252,0.86)",
        "lineHeight": 1.45,
        "lines": [
          [
            { "text": "Também quer " },
            { "text": "campanhas automáticas no WhatsApp", "color": "#FAFAFA", "weight": "bold" },
            { "text": " com mensagens no timing certo?" }
          ],
          [
            { "text": "Com o " },
            { "text": "RecompraCRM", "color": "#FFCD2E", "weight": "bold" },
            { "text": ", você pode." }
          ]
        ]
      }
    },
    "cta-button": {
      "type": "MediaBadge",
      "props": {
        "label": "Venha já testar",
        "background": "linear-gradient(180deg, #FFCD2E 0%, #FFB800 100%)",
        "color": "#0A0F18",
        "fontSize": 12,
        "fontWeight": "bold",
        "borderRadius": 12,
        "paddingX": 18,
        "paddingY": 12,
        "boxShadow": "0 10px 28px rgba(255,184,0,0.24), inset 0 1px 0 rgba(255,255,255,0.45)",
        "tracking": "-0.01em"
      }
    },
    "club": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,1fr)", "auto"],
        "gap": 12,
        "alignItems": "center",
        "background": "rgba(255,255,255,0.08)",
        "border": "1px solid rgba(255,255,255,0.10)",
        "borderRadius": 999,
        "paddingY": 12,
        "paddingX": 18
      },
      "children": ["club-text", "club-status"]
    },
    "club-text": {
      "type": "MediaText",
      "props": {
        "text": "CLUBE CAMPEÕES AMPÈRE+",
        "size": 12,
        "weight": "bold",
        "color": "#F8FAFC",
        "uppercase": true,
        "tracking": "0.16em"
      }
    },
    "club-status": {
      "type": "MediaBadge",
      "props": {
        "label": "ATIVA",
        "background": "rgba(255,205,46,0.18)",
        "color": "#FFDD6E",
        "fontSize": 11,
        "fontWeight": "bold",
        "borderRadius": 999,
        "paddingX": 12,
        "paddingY": 8,
        "border": "1px solid rgba(255,205,46,0.28)",
        "tracking": "0.12em"
      }
    },
    "metrics": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,1fr)", "minmax(0,1fr)", "minmax(0,1fr)"],
        "gap": 14
      },
      "children": ["metric-ticket", "metric-reached", "metric-anticipation"]
    },
    "metric-ticket": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Impacto no ticket",
        "value": "+51,78%",
        "background": "linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%)",
        "valueColor": "#059669",
        "labelColor": "#64748B",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 24
      }
    },
    "metric-reached": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Clientes alcançados",
        "value": "99",
        "background": "linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%)",
        "valueColor": "#1E3A5F",
        "labelColor": "#64748B",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 24
      }
    },
    "metric-anticipation": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Antecipação média",
        "value": "10,7 dias",
        "background": "linear-gradient(135deg, #FFFBF0 0%, #FFF6E0 100%)",
        "valueColor": "#D4A012",
        "labelColor": "#7C6B2E",
        "border": "1px solid rgba(255,185,0,0.35)",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 24
      }
    },
    "distribution-row": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,7fr)", "minmax(0,4fr)"],
        "gap": 14,
        "alignItems": "stretch"
      },
      "children": ["distribution-card", "impact-panels"]
    },
    "distribution-card": {
      "type": "MediaDistributionListCard",
      "props": {
        "title": "Conversões por tipo",
        "background": "linear-gradient(180deg, rgba(14,30,56,0.88) 0%, rgba(10,20,38,0.94) 100%)",
        "border": "1px solid rgba(255,255,255,0.08)",
        "boxShadow": "0 18px 40px rgba(0,0,0,0.18)",
        "borderRadius": 20,
        "paddingX": 20,
        "paddingY": 18,
        "tagline": "Dados que viram relacionamento — e relacionamento que viram receita.",
        "items": [
          { "label": "Aceleração", "count": 109, "percentage": 75.69, "revenue": "R$ 19.936,77", "color": "#EAB308" },
          { "label": "Atrasada", "count": 17, "percentage": 11.81, "revenue": "R$ 4.087,13", "color": "#EF4444" },
          { "label": "Regular", "count": 14, "percentage": 9.72, "revenue": "R$ 4.938,85", "color": "#9CA3AF" },
          { "label": "Reativação", "count": 4, "percentage": 2.78, "revenue": "R$ 445,88", "color": "#3B82F6" }
        ]
      }
    },
    "impact-panels": {
      "type": "MediaStack",
      "props": {
        "gap": 12,
        "height": "100%"
      },
      "children": ["impact-frequency", "impact-monetary"]
    },
    "impact-frequency": {
      "type": "MediaInsightPanel",
      "props": {
        "title": "Impacto na frequência",
        "background": "linear-gradient(180deg, rgba(14,30,56,0.82) 0%, rgba(10,20,38,0.88) 100%)",
        "border": "1px solid rgba(255,255,255,0.08)",
        "borderRadius": 20,
        "paddingX": 18,
        "paddingY": 16,
        "items": [
          { "label": "Compras aceleradas", "value": "109" },
          { "label": "Compras atrasadas", "value": "21", "positive": false },
          { "label": "Antecipação média", "value": "10,7 dias" }
        ]
      }
    },
    "impact-monetary": {
      "type": "MediaInsightPanel",
      "props": {
        "title": "Impacto monetário",
        "background": "linear-gradient(180deg, rgba(14,30,56,0.82) 0%, rgba(10,20,38,0.88) 100%)",
        "border": "1px solid rgba(255,255,255,0.08)",
        "borderRadius": 20,
        "paddingX": 18,
        "paddingY": 16,
        "items": [
          { "label": "Acima do ticket médio", "value": "61" },
          { "label": "Abaixo do ticket médio", "value": "83", "positive": false },
          { "label": "Variação média", "value": "+51,78%" }
        ]
      }
    },
    "delivery": {
      "type": "MediaGrid",
      "props": {
        "columns": ["minmax(0,1fr)", "minmax(0,1fr)", "minmax(0,1fr)", "minmax(0,1fr)"],
        "gap": 14
      },
      "children": ["delivery-converted", "delivery-sent", "delivery-ticket", "delivery-time"]
    },
    "delivery-converted": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Clientes convertidos",
        "value": "36",
        "background": "rgba(255,255,255,0.92)",
        "valueColor": "#0F172A",
        "labelColor": "#64748B",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 19
      }
    },
    "delivery-sent": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Mensagens entregues",
        "value": "140",
        "background": "rgba(255,255,255,0.92)",
        "valueColor": "#0F172A",
        "labelColor": "#64748B",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 19
      }
    },
    "delivery-ticket": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Ticket médio conv.",
        "value": "R$ 204,23",
        "background": "rgba(255,255,255,0.92)",
        "valueColor": "#0F172A",
        "labelColor": "#64748B",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 19
      }
    },
    "delivery-time": {
      "type": "MediaMetricCard",
      "props": {
        "label": "Tempo médio conv.",
        "value": "111,6h",
        "background": "rgba(255,255,255,0.92)",
        "valueColor": "#0F172A",
        "labelColor": "#64748B",
        "borderRadius": 18,
        "paddingX": 18,
        "paddingY": 16,
        "labelSize": 9,
        "valueSize": 19
      }
    },
    "footer": {
      "type": "MediaGrid",
      "props": {
        "position": "absolute",
        "left": { "$state": "/layout/padXPx" },
        "right": { "$state": "/layout/padXPx" },
        "bottom": { "$state": "/layout/footerBottomPx" },
        "columns": ["auto", "auto"],
        "alignItems": "center",
        "justifyItems": "stretch",
        "borderTop": "1px solid rgba(255,255,255,0.12)",
        "paddingTop": 14,
        "zIndex": 2
      },
      "children": ["footer-logo", "footer-cta"]
    },
    "footer-logo": {
      "type": "MediaLogo",
      "props": {
        "asset": "recompra-horizontal-colorful",
        "alt": "RecompraCRM",
        "height": 52,
        "maxWidth": "25%"
      }
    },
    "footer-cta": {
      "type": "MediaStack",
      "props": {
        "direction": "row",
        "alignItems": "center",
        "justifySelf": "end",
        "gap": 12
      },
      "children": ["footer-copy", "footer-button"]
    },
    "footer-copy": {
      "type": "MediaText",
      "props": {
        "text": "Conheça e",
        "size": 16,
        "weight": "medium",
        "color": "rgba(248,250,252,0.55)"
      }
    },
    "footer-button": {
      "type": "MediaBadge",
      "props": {
        "label": "Comece grátis",
        "background": "linear-gradient(180deg, #FFCD2E 0%, #FFB800 100%)",
        "color": "#0A0F18",
        "fontSize": 16,
        "fontWeight": "bold",
        "borderRadius": 10,
        "paddingX": 24,
        "paddingY": 10,
        "boxShadow": "0 10px 28px rgba(255,184,0,0.3), inset 0 1px 0 rgba(255,255,255,0.45)",
        "tracking": "-0.02em"
      }
    }
  }
}
